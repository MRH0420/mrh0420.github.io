---
import { siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { resolveConfiguredAsset } from "@/utils/asset-resolver";

const galleryConfig = siteConfig.mySection.gallery;
if (!siteConfig.mySection.enable || !galleryConfig.enable) {
	return Astro.redirect("/");
}

const categories = galleryConfig.categories.map((category) => ({
	...category,
	coverUrl: resolveConfiguredAsset(category.cover),
	previewUrls: category.photos
		.slice(0, 3)
		.map((photo) => resolveConfiguredAsset(photo))
		.filter(Boolean) as string[],
}));
---

<MainGridLayout title={galleryConfig.title} description={galleryConfig.subtitle}>
	<section class="space-y-5">
		<div class="card-base px-6 py-6 md:px-8">
			<div class="mb-2 text-[0.75rem] font-semibold uppercase tracking-[0.18em] text-[var(--primary)]">My</div>
			<h1 class="text-3xl font-bold text-90 md:text-4xl">{galleryConfig.title}</h1>
			<p class="mt-3 max-w-2xl text-sm text-50 md:text-base">{galleryConfig.subtitle}</p>
		</div>

		<div class="grid gap-5">
			{categories.map((category) => (
				<a href={`${galleryConfig.slug}${category.slug}/`} class="group card-base overflow-hidden">
					<div class="grid grid-cols-[minmax(0,2fr)_minmax(0,3fr)] gap-0">
						<div class="relative min-h-[10.5rem] overflow-hidden md:min-h-[11.5rem]">
							{category.coverUrl && <img src={category.coverUrl} alt={category.title} class="h-full w-full object-cover opacity-[0.9] transition duration-500 group-hover:scale-[1.04]" />}
							<div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(15,23,42,0.08)_0%,rgba(15,23,42,0.54)_100%)]"></div>
							<div class="absolute inset-x-0 bottom-0 p-3 md:p-4">
								<h2 class="text-lg font-bold text-white md:text-xl">{category.title}</h2>
								{category.description && <p class="mt-1 line-clamp-2 max-w-lg text-[0.72rem] text-white/76 md:text-xs">{category.description}</p>}
							</div>
						</div>
						<div class="relative flex min-w-0 flex-col justify-between p-2.5 md:p-3">
							<div class="grid h-full grid-cols-2 gap-2">
								{category.previewUrls.map((photo, index) => (
									<div class:list={[
										"overflow-hidden rounded-[1rem] bg-[var(--btn-regular-bg)]",
										index === 0 ? "row-span-2 h-full min-h-0" : "h-full min-h-0",
									]}>
										<img src={photo} alt={`${category.title} preview ${index + 1}`} class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]" />
									</div>
								))}
							</div>
							<div class="mt-2 flex items-center justify-between rounded-[1rem] bg-[var(--btn-regular-bg)] px-3 py-2.5">
								<div>
									<div class="text-sm font-semibold text-90">{category.photos.length} Photos</div>
									<div class="text-[0.68rem] uppercase tracking-[0.12em] text-50">Open Category</div>
								</div>
								<div class="flex h-9 w-9 items-center justify-center rounded-[0.9rem] bg-[var(--surface-tint)] text-[var(--primary)]">
									&rarr;
								</div>
							</div>
						</div>
					</div>
				</a>
			))}
		</div>
	</section>
</MainGridLayout>
