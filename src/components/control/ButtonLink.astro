---
interface Props {
	badge?: string;
	url?: string;
	label?: string;
}
const { badge, url, label } = Astro.props;
---
<a
    href={url}
    aria-label={label}
    class="group flex min-h-11 w-full items-center justify-between gap-3 rounded-xl px-3 py-2 text-left text-[var(--text-secondary)] hover:bg-[var(--btn-plain-bg-hover)] hover:text-[var(--primary)] active:bg-[var(--btn-plain-bg-active)]"
>
    <div class="min-w-0 overflow-hidden text-ellipsis whitespace-nowrap font-medium">
        <slot></slot>
    </div>
    { badge !== undefined && badge !== null && badge !== '' &&
        <div class="flex h-7 min-w-[2.25rem] items-center justify-center rounded-[var(--radius-pill)] bg-[var(--surface-tint-strong)] px-2 text-sm font-bold text-[var(--btn-content)] group-hover:bg-[var(--btn-regular-bg)]">
            { badge }
        </div>
    }
</a>
</a>
