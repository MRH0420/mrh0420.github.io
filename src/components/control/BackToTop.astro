---
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";

const showRotatingImage = siteConfig.backToTop.image.enable;
type BackToTopImageAsset = {
	src: string;
};

// Resolve the rotating image from config.ts so the button art can be swapped without editing this component.
const backToTopImageModules = import.meta.glob<BackToTopImageAsset>(
	"../../assets/**/*",
	{
		eager: true,
		import: "default",
	},
);
const configuredRotateImage = siteConfig.backToTop.image.src.startsWith("/")
	? siteConfig.backToTop.image.src
	: backToTopImageModules[`../../${siteConfig.backToTop.image.src}`];
const rotateImageUrl =
	typeof configuredRotateImage === "string"
		? configuredRotateImage
		: configuredRotateImage?.src;
---

<!-- There can't be a filter on parent element, or it will break `fixed` -->
<div class="back-to-top-wrapper hidden lg:block">
	<button
		type="button"
		id="back-to-top-btn"
		aria-label="Back to Top"
		class:list={[
			"back-to-top-btn hide btn-card rounded-[1.25rem] h-[3.75rem] w-[3.75rem]",
			{ "back-to-top-btn-with-image": showRotatingImage },
		]}
		onclick="backToTop()"
	>
		{showRotatingImage && rotateImageUrl ? (
			<>
				<!-- The Taichi artwork is the default state and rotates continuously. -->
				<img
					src={rotateImageUrl}
					alt=""
					aria-hidden="true"
					class="back-to-top-image"
				/>
				<!-- The hover state switches to a Font Awesome arrow to keep the action obvious. -->
				<Icon name="material-symbols:keyboard-arrow-up-rounded" class="back-to-top-hover-icon" />
			</>
		) : (
			<Icon name="material-symbols:keyboard-arrow-up-rounded" class="mx-auto" />
		)}
	</button>
</div>

<style lang="stylus">
.back-to-top-wrapper
	width: 3.75rem
	height: 3.75rem
	position: absolute
	right: 0
	top: 0
	pointer-events: none

.back-to-top-btn
	color: var(--primary)
	font-size: 2.25rem
	font-weight: bold
	position: fixed
	bottom: 10rem
	opacity: 1
	cursor: pointer
	transform: translateX(5rem)
	pointer-events: auto
	box-shadow: var(--shadow-card)
	display: flex
	align-items: center
	justify-content: center
	overflow: hidden
	i
		font-size: 1.75rem
	&.hide
		transform: translateX(5rem) scale(0.9)
		opacity: 0
		pointer-events: none
	&:active
		transform: translateX(5rem) scale(0.9)

.back-to-top-image
	width: 2.4rem
	height: 2.4rem
	object-fit: contain
	animation: taichi-spin 7s linear infinite
	transition: opacity 0.2s ease, transform 0.2s ease

.back-to-top-hover-icon
	position: absolute
	opacity: 0
	transform: scale(0.8)
	transition: opacity 0.2s ease, transform 0.2s ease

.back-to-top-btn-with-image:hover
	.back-to-top-image
		opacity: 0
		transform: scale(0.85)

	.back-to-top-hover-icon
		opacity: 1
		transform: scale(1)

@keyframes taichi-spin
	from
		transform: rotate(0deg)
	to
		transform: rotate(360deg)

</style>

<script is:raw is:inline>
function backToTop() {
    window.scroll({ top: 0, behavior: 'smooth' });
}
</script>
