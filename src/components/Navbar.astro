---
import { Icon } from "astro-icon/components";
import logoImage from "@assets/images/logo3.png";
import { navBarConfig, siteConfig } from "../config";
import { LinkPresets } from "../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../types/config";
import { pathsEqual, url } from "../utils/url-utils";
import LightDarkSwitch from "./LightDarkSwitch.svelte";
import Search from "./Search.svelte";
import DisplaySettings from "./widget/DisplaySettings.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";

const className = Astro.props.class;

let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return LinkPresets[item];
		}
		return item;
	},
);

const currentPath = Astro.url.pathname;
---
<div id="navbar" class="z-50 onload-animation">
    <div class="absolute h-8 left-0 right-0 -top-8 bg-[var(--card-bg)] transition"></div> <!-- used for onload animation -->
    <nav aria-label="Primary" class:list={[
        className,
        "card-base !bg-[oklch(from_var(--card-bg-solid)_l_c_h_/_0.62)] !overflow-visible max-w-[var(--page-width)] min-h-[4.5rem] !rounded-t-none mx-auto flex items-center justify-between gap-2 px-3 md:px-4"]}>
        <a href={url('/')} aria-label={`Go to ${siteConfig.title} home`} class="btn-plain scale-animation rounded-xl h-[3.25rem] px-3 md:px-4 font-bold active:scale-95">
            <div class="flex flex-row items-center text-base tracking-[0.01em] text-[var(--primary)]">
                <img 
                    src={logoImage.src}
                    alt=""
                    class="w-[2.4rem] h-[2.4rem] object-cover rounded-xl mr-2 shadow-sm" 
                />
                <span class="hidden sm:inline">{siteConfig.title}</span>
            </div>
        </a>
        <div class="hidden md:flex items-center gap-1">
            {links.map((l) => {
                const href = l.external ? l.url : url(l.url);
                const isCurrent = !l.external && pathsEqual(currentPath, href);
                return <a aria-label={l.name} href={href} target={l.external ? "_blank" : null}
                          data-nav-link={!l.external ? "true" : null}
                          data-nav-href={!l.external ? href : null}
                          aria-current={isCurrent ? "page" : null}
                          class:list={["btn-plain scale-animation rounded-xl h-11 font-bold px-4 active:scale-95", {
                              "bg-[var(--surface-tint)] text-[var(--primary)]": isCurrent,
                          }]}
                >
                    <div class="flex items-center">
                        {l.name}
                        {l.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.875rem] transition -translate-y-[1px] ml-1 text-black/[0.2] dark:text-white/[0.2]"></Icon>}
                    </div>
                </a>;
            })}
        </div>
        <div class="flex items-center gap-1">
            <!--<SearchPanel client:load>-->
            <Search client:only="svelte"></Search>
            {!siteConfig.themeColor.fixed && (
                    <button type="button" aria-label="Display Settings" aria-haspopup="dialog" aria-controls="display-setting" aria-expanded="false" class="btn-plain scale-animation rounded-xl h-11 w-11 active:scale-90" id="display-settings-switch">
                        <Icon name="material-symbols:palette-outline" class="text-[1.25rem]"></Icon>
                    </button>
            )}
            {siteConfig.theme.toggleable && <LightDarkSwitch client:only="svelte"></LightDarkSwitch>}
            <button type="button" aria-label="Menu" aria-haspopup="menu" aria-controls="nav-menu-panel" aria-expanded="false" name="Nav Menu" class="btn-plain scale-animation rounded-xl w-11 h-11 active:scale-90 md:!hidden" id="nav-menu-switch">
                <Icon name="material-symbols:menu-rounded" class="text-[1.25rem]"></Icon>
            </button>
        </div>
        <NavMenuPanel links={links}></NavMenuPanel>
        <DisplaySettings client:only="svelte"></DisplaySettings>
    </nav>
</div>

<script>
function switchTheme() {
    if (localStorage.theme === 'dark') {
        document.documentElement.classList.remove('dark');
        localStorage.theme = 'light';
    } else {
        document.documentElement.classList.add('dark');
        localStorage.theme = 'dark';
    }
}

function updateActiveNavState(nextHref: string) {
    const navLinks = document.querySelectorAll('[data-nav-link="true"]');
    for (const navLink of navLinks) {
        const href = navLink.getAttribute("data-nav-href");
        const isActive = href === nextHref;
        navLink.classList.toggle("bg-[var(--surface-tint)]", isActive);
        navLink.classList.toggle("text-[var(--primary)]", isActive);
        if (isActive) {
            navLink.setAttribute("aria-current", "page");
        } else {
            navLink.removeAttribute("aria-current");
        }
    }
}

function loadNavScript() {
    const navLinks = document.querySelectorAll('[data-nav-link="true"]');
    for (const navLink of navLinks) {
        navLink.addEventListener("click", () => {
            const href = navLink.getAttribute("data-nav-href");
            if (href) {
                updateActiveNavState(href);
            }
        });
    }

    const swup = window.swup;
    if (swup?.hooks) {
        swup.hooks.off?.("page:view", syncNavStateWithLocation);
        swup.hooks.on("page:view", syncNavStateWithLocation);
    }
}

function syncNavStateWithLocation() {
    updateActiveNavState(window.location.pathname);
}

function loadButtonScript() {
    let switchBtn = document.getElementById("scheme-switch");
    if (switchBtn) {
        switchBtn.onclick = function () {
            switchTheme()
        };
    }

    let settingBtn = document.getElementById("display-settings-switch");
    if (settingBtn) {
        settingBtn.onclick = function () {
            let settingPanel = document.getElementById("display-setting");
            if (settingPanel) {
                settingPanel.classList.toggle("float-panel-closed");
                const expanded = !settingPanel.classList.contains("float-panel-closed");
                settingBtn.setAttribute("aria-expanded", String(expanded));
            }
        };
    }

    let menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn) {
        menuBtn.onclick = function () {
            let menuPanel = document.getElementById("nav-menu-panel");
            if (menuPanel) {
                menuPanel.classList.toggle("float-panel-closed");
                const expanded = !menuPanel.classList.contains("float-panel-closed");
                menuBtn.setAttribute("aria-expanded", String(expanded));
            }
        };
    }
}

loadButtonScript();
loadNavScript();
syncNavStateWithLocation();
</script>

{import.meta.env.PROD && <script is:inline define:vars={{scriptUrl: url('/pagefind/pagefind.js')}}>
async function loadPagefind() {
    try {
        const response = await fetch(scriptUrl, { method: 'HEAD' });
        if (!response.ok) {
            throw new Error(`Pagefind script not found: ${response.status}`);
        }

        const pagefind = await import(scriptUrl);

        await pagefind.options({
            excerptLength: 20
        });

        window.pagefind = pagefind;

        document.dispatchEvent(new CustomEvent('pagefindready'));
        console.log('Pagefind loaded and initialized successfully, event dispatched.');
    } catch (error) {
        console.error('Failed to load Pagefind:', error);
        window.pagefind = {
            search: () => Promise.resolve({ results: [] }),
            options: () => Promise.resolve(),
        };
        document.dispatchEvent(new CustomEvent('pagefindloaderror'));
        console.log('Pagefind load error, event dispatched.');
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadPagefind);
} else {
    loadPagefind();
}
</script>}
