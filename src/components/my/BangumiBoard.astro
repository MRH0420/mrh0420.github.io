---
import type { MyAnimeEventItem, MyBangumiSubjectTypeKey } from "@/types/config";

interface Props {
	userId: string;
	accessToken: string;
	defaultTab: MyBangumiSubjectTypeKey;
	subjectTypes: MyBangumiSubjectTypeKey[];
	pageSize: number;
	events: (MyAnimeEventItem & { coverUrl?: string; displayYear?: string })[];
}

type BangumiCollectionType = 1 | 2 | 3 | 4 | 5;
type BangumiFilterKey = "all" | BangumiCollectionType;
type EventFilterKey = "all" | "wish" | "visited";

interface BangumiImageSet {
	large?: string;
	common?: string;
	medium?: string;
	small?: string;
	grid?: string;
}

interface BangumiSubject {
	id: number;
	type: number;
	name: string;
	name_cn?: string;
	eps?: number;
	score?: number;
	date?: string;
	images?: BangumiImageSet;
}

interface BangumiCollectionItem {
	subject_id: number;
	subject: BangumiSubject;
	ep_status: number;
	type: BangumiCollectionType;
	rate?: number;
}

interface BangumiCollectionResponse {
	data?: BangumiCollectionItem[];
	total?: number;
}

type BangumiSubjectMeta = {
	key: MyBangumiSubjectTypeKey;
	name: string;
	subjectType: number;
};

type SerializedBangumiEntry = {
	subjectId: number;
	title: string;
	originalTitle: string;
	totalEpisodes: number;
	watchedEpisodes: number;
	progressPercent: number;
	score: number | null;
	year: string;
	image: string;
	link: string;
	status: BangumiCollectionType;
	subjectTypeKey: MyBangumiSubjectTypeKey;
};

const { userId, accessToken, defaultTab, subjectTypes, pageSize, events } = Astro.props;

const allSubjectMeta: Record<MyBangumiSubjectTypeKey, BangumiSubjectMeta> = {
	anime: { key: "anime", name: "动画", subjectType: 2 },
	book: { key: "book", name: "书籍", subjectType: 1 },
	music: { key: "music", name: "音乐", subjectType: 3 },
	game: { key: "game", name: "游戏", subjectType: 4 },
	real: { key: "real", name: "三次元", subjectType: 6 },
};

const enabledSubjects = subjectTypes
	.map((key) => allSubjectMeta[key])
	.filter((value): value is BangumiSubjectMeta => Boolean(value));

const filterOptions: { key: BangumiFilterKey; label: string }[] = [
	{ key: "all", label: "全部" },
	{ key: 2, label: "看过" },
	{ key: 3, label: "在看" },
	{ key: 1, label: "想看" },
	{ key: 4, label: "搁置" },
	{ key: 5, label: "抛弃" },
];

const eventFilterOptions: { key: EventFilterKey; label: string }[] = [
	{ key: "all", label: "全部" },
	{ key: "visited", label: "看过" },
	{ key: "wish", label: "想看" },
];

const bangumiData: Record<MyBangumiSubjectTypeKey, SerializedBangumiEntry[]> = {
	anime: [],
	book: [],
	music: [],
	game: [],
	real: [],
};

let allDataFetched = true;
let fetchErrorMessage = "";

const apiBase = "https://api.bgm.tv/v0";

const pickImage = (images?: BangumiImageSet) =>
	images?.large || images?.common || images?.medium || images?.small || images?.grid || "";

const normalizeEntry = (item: BangumiCollectionItem, subjectTypeKey: MyBangumiSubjectTypeKey): SerializedBangumiEntry => {
	const subject = item.subject || ({} as BangumiSubject);
	const totalEpisodes = subject.eps || 0;
	const watchedEpisodes = item.ep_status || 0;
	const progressPercent = totalEpisodes
		? Math.min(100, Math.round((watchedEpisodes / totalEpisodes) * 100))
		: 0;
	const score = typeof item.rate === "number" && item.rate > 0
		? item.rate
		: typeof subject.score === "number" && subject.score > 0
			? subject.score
			: null;

	return {
		subjectId: subject.id || item.subject_id,
		title: subject.name_cn || subject.name || "Untitled",
		originalTitle: subject.name || subject.name_cn || "Untitled",
		totalEpisodes,
		watchedEpisodes,
		progressPercent,
		score,
		year: subject.date ? String(subject.date).slice(0, 4) : "",
		image: pickImage(subject.images),
		link: `https://bgm.tv/subject/${subject.id || item.subject_id}`,
		status: item.type,
		subjectTypeKey,
	};
};

const fetchAllForSubjectType = async (subjectType: number): Promise<BangumiCollectionItem[]> => {
	if (!userId || !accessToken) return [];

	let offset = 0;
	let total = Number.POSITIVE_INFINITY;
	const items: BangumiCollectionItem[] = [];

	while (offset < total) {
		const response = await fetch(
			`${apiBase}/users/${encodeURIComponent(userId)}/collections?subject_type=${subjectType}&limit=50&offset=${offset}`,
			{
				headers: {
					Authorization: `Bearer ${accessToken}`,
				},
			},
		);

		if (!response.ok) {
			const errorText = await response.text();
			throw new Error(`Bangumi API error (${subjectType}): ${response.status} ${errorText}`);
		}

		const json = await response.json() as BangumiCollectionResponse;
		const batch = Array.isArray(json.data) ? json.data : [];
		total = typeof json.total === "number" ? json.total : batch.length;
		items.push(...batch);

		if (batch.length === 0) break;
		offset += batch.length;
	}

	return items;
};

if (userId && accessToken) {
	try {
		const results = await Promise.all(
			enabledSubjects.map(async (subjectMeta) => ({
				key: subjectMeta.key,
				items: await fetchAllForSubjectType(subjectMeta.subjectType),
			})),
		);

		results.forEach((result) => {
			bangumiData[result.key] = result.items.map((item) => normalizeEntry(item, result.key));
		});
	} catch (error) {
		console.error(error);
		allDataFetched = false;
		fetchErrorMessage = "Failed to load Bangumi data from the server.";
	}
} else {
	allDataFetched = false;
	fetchErrorMessage = "Please configure siteConfig.mySection.anime.bangumi.userId and accessToken first.";
}

const visibleSubjects = enabledSubjects.filter((subjectMeta) => bangumiData[subjectMeta.key].length > 0);
const defaultVisibleTab = visibleSubjects.some((subjectMeta) => subjectMeta.key === defaultTab)
	? defaultTab
	: visibleSubjects[0]?.key || "anime";
const totalCount = Object.values(bangumiData).flat().length;
const watchingCount = Object.values(bangumiData).flat().filter((item) => item.status === 3).length;
const completedCount = Object.values(bangumiData).flat().filter((item) => item.status === 2).length;
const eventCount = events.length;
const boardTabs = [
	...visibleSubjects,
	...(events.length > 0 ? [{ key: "event" as const, name: "现地" }] : []),
];
const defaultBoardTab = boardTabs.some((tab) => tab.key === defaultVisibleTab)
	? defaultVisibleTab
	: boardTabs[0]?.key || "anime";
---

<section class="card-base overflow-visible px-5 py-5 md:px-8 md:py-6">
	<div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
		<div>
			<div class="mb-2 text-[0.75rem] font-semibold uppercase tracking-[0.18em] text-[var(--primary)]">My</div>
			<h1 class="text-3xl font-bold text-90 md:text-4xl">Bangumi</h1>
		</div>
		<div class="grid grid-cols-3 gap-2.5 md:min-w-[23rem] md:gap-3">
			<div class="bangumi-stat">
				<div class="text-lg font-bold text-90 md:text-xl">{totalCount + eventCount}</div>
				<div class="text-[0.68rem] uppercase tracking-[0.12em] text-50 md:text-xs">Loaded</div>
			</div>
			<div class="bangumi-stat">
				<div class="text-lg font-bold text-90 md:text-xl">{watchingCount}</div>
				<div class="text-[0.68rem] uppercase tracking-[0.12em] text-50 md:text-xs">Watching</div>
			</div>
			<div class="bangumi-stat">
				<div class="text-lg font-bold text-90 md:text-xl">{completedCount}</div>
				<div class="text-[0.68rem] uppercase tracking-[0.12em] text-50 md:text-xs">Completed</div>
			</div>
		</div>
	</div>

	{allDataFetched ? (
		<div
			id="bangumi-board"
			class="mt-5"
			data-page-size={String(pageSize)}
			data-default-tab={defaultBoardTab}
		>
			<script
				id="bangumi-board-data"
				type="application/json"
				is:inline
				set:html={JSON.stringify({ boardTabs, bangumiData, filterOptions, eventFilterOptions, events })}
			></script>

			<div class="overflow-x-auto overflow-y-hidden">
				<div class="flex min-w-max items-center gap-6 border-b border-[rgba(148,163,184,0.18)] pb-3 md:gap-7" role="tablist" id="bangumi-tabs">
					{boardTabs.map((subjectMeta) => (
						<button
							type="button"
							class:list={["bangumi-tab", subjectMeta.key === defaultBoardTab && "bangumi-tab-active"]}
							data-target={subjectMeta.key}
							role="tab"
							aria-selected={subjectMeta.key === defaultBoardTab ? "true" : "false"}
						>
							<span>{subjectMeta.name}</span>
							<span class="bangumi-tab-count">{subjectMeta.key === "event" ? events.length : bangumiData[subjectMeta.key].length}</span>
						</button>
					))}
				</div>
			</div>

			<div id="bangumi-filters" class="mt-4 flex flex-wrap gap-2"></div>
			<div id="bangumi-panel-root" class="mt-5"></div>
			<div id="bangumi-pagination" class="mt-5 flex flex-wrap items-center justify-center gap-2"></div>
		</div>
	) : (
		<div class="mt-5 rounded-[1rem] bg-[var(--btn-regular-bg)] px-4 py-4 text-sm text-[rgb(248,113,113)]">
			{fetchErrorMessage}
		</div>
	)}
</section>

<script is:inline data-astro-rerun>
function initBangumiBoard() {
	const bangumiRoot = document.getElementById("bangumi-board");
	if (!bangumiRoot || bangumiRoot.dataset.initialized === "true") return;
	bangumiRoot.dataset.initialized = "true";

	const dataScript = document.getElementById("bangumi-board-data");
	const parsed = dataScript ? JSON.parse(dataScript.textContent || "{}") : { boardTabs: [], bangumiData: {}, filterOptions: [], eventFilterOptions: [], events: [] };
	const boardTabs = parsed.boardTabs || [];
	const bangumiData = parsed.bangumiData || {};
	const filterOptions = parsed.filterOptions || [];
	const eventFilterOptions = parsed.eventFilterOptions || [];
	const events = parsed.events || [];
	const pageSize = Number.parseInt(bangumiRoot.dataset.pageSize || "12", 10);
	const panelRoot = document.getElementById("bangumi-panel-root");
	const paginationRoot = document.getElementById("bangumi-pagination");
	const filtersRoot = document.getElementById("bangumi-filters");
	const tabs = Array.from(document.querySelectorAll("#bangumi-tabs [data-target]"));

	let activeTab = bangumiRoot.dataset.defaultTab || "anime";
	let activeFilter = "all";
	let currentPage = 1;

	const escapeHtml = (value) =>
		String(value)
			.replaceAll("&", "&amp;")
			.replaceAll("<", "&lt;")
			.replaceAll(">", "&gt;")
			.replaceAll('"', "&quot;")
			.replaceAll("'", "&#39;");

	const currentItems = () => activeTab === "event" ? events : bangumiData[activeTab] || [];

	const currentFilterCounts = () => {
		const items = currentItems();
		const counts = { all: items.length };
		for (const item of items) {
			const key = activeTab === "event" ? item.status : item.status;
			counts[key] = (counts[key] || 0) + 1;
		}
		return counts;
	};

	const renderFilters = () => {
		const counts = currentFilterCounts();
		const baseFilters = activeTab === "event" ? eventFilterOptions : filterOptions;
		const visibleFilters = baseFilters.filter((filter) => filter.key === "all" || (counts[filter.key] || 0) > 0);
		if (!visibleFilters.some((filter) => String(filter.key) === String(activeFilter))) {
			activeFilter = "all";
		}

		filtersRoot.innerHTML = visibleFilters
			.map((filter) => `
				<button
					type="button"
					class="bangumi-filter ${String(filter.key) === String(activeFilter) ? "bangumi-filter-active" : ""}"
					data-filter="${escapeHtml(filter.key)}"
				>
					${escapeHtml(filter.label)}
					<span class="ml-1 opacity-65">(${escapeHtml(counts[filter.key] || 0)})</span>
				</button>
			`)
			.join("");

		filtersRoot.querySelectorAll("[data-filter]").forEach((button) => {
			button.addEventListener("click", () => {
				activeFilter = button.getAttribute("data-filter") || "all";
				currentPage = 1;
				renderCards();
				renderFilters();
			});
		});
	};

	const filteredItems = () => {
		const items = currentItems();
		return activeFilter === "all" ? items : items.filter((item) => String(item.status) === String(activeFilter));
	};

	const renderCards = () => {
		const items = filteredItems();
		if (!items.length) {
			panelRoot.innerHTML = `<div class="rounded-[1rem] bg-[var(--btn-regular-bg)] px-4 py-10 text-center text-sm text-50">这个分类下暂时没有记录。</div>`;
			paginationRoot.innerHTML = "";
			return;
		}

		const start = (currentPage - 1) * pageSize;
		const pageItems = items.slice(start, start + pageSize);
		if (activeTab === "event") {
			panelRoot.innerHTML = `
				<div class="grid gap-4 md:grid-cols-2">
					${pageItems.map((item) => `
						<article class="card-base bangumi-event-card overflow-hidden">
							<div class="flex flex-col">
								<div class="relative aspect-[16/6.2] overflow-hidden">
									${item.coverUrl
										? `<img src="${escapeHtml(item.coverUrl)}" alt="${escapeHtml(item.description)}" class="h-full w-full object-cover object-center opacity-[0.92] transition duration-300" />`
										: `<div class="flex h-full w-full items-center justify-center text-sm text-50">No Image</div>`}
									<div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(15,23,42,0.12)_0%,rgba(15,23,42,0.58)_100%)]"></div>
									${item.displayYear ? `<div class="absolute right-3 top-3 rounded-full bg-black/28 px-2.5 py-1 text-[0.7rem] font-semibold uppercase tracking-[0.12em] text-white/82 backdrop-blur-md">${escapeHtml(item.displayYear)}</div>` : ""}
								</div>
								<div class="flex flex-col justify-between px-4 py-3 md:px-4 md:py-3.5">
									<div>
										<div class="mb-2 inline-flex rounded-full bg-[var(--btn-regular-bg)] px-2.5 py-1 text-[0.66rem] font-semibold uppercase tracking-[0.12em] text-[var(--primary)]">
											${item.status === "visited" ? "看过" : "想看"}
										</div>
										<h3 class="text-base font-bold leading-tight text-90 md:text-[1.2rem]">${escapeHtml(item.description)}</h3>
										<div class="mt-2 flex items-end justify-between gap-3 text-[0.82rem] text-50">
											<p class="min-w-0">${escapeHtml(item.date)}</p>
											${item.location
												? `<div class="shrink-0 text-right text-[0.72rem] font-medium uppercase tracking-[0.12em] text-50">${escapeHtml(item.location)}</div>`
												: ""}
										</div>
									</div>
									${item.link
										? `<div class="mt-3"><a href="${escapeHtml(item.link)}" target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--primary)] hover:text-[var(--link-hover)]">Open event<span aria-hidden="true">&rarr;</span></a></div>`
										: ""}
								</div>
							</div>
						</article>
					`).join("")}
				</div>
			`;
		} else {
			panelRoot.innerHTML = `
			<div class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4 xl:grid-cols-4 2xl:grid-cols-5">
				${pageItems.map((item) => `
					<a
						href="${escapeHtml(item.link)}"
						target="_blank"
						rel="noopener"
						class="group card-base bangumi-card overflow-hidden"
					>
						<div class="relative aspect-[2/3] overflow-hidden bg-[var(--btn-regular-bg)]">
							${item.image
								? `<img src="${escapeHtml(item.image)}" alt="${escapeHtml(item.title)}" class="h-full w-full object-cover opacity-[0.92] transition duration-300 group-hover:scale-[1.03]" />`
								: `<div class="flex h-full w-full items-center justify-center text-sm text-50">No Image</div>`}
							<div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(15,23,42,0.06)_0%,rgba(15,23,42,0.86)_100%)]"></div>
							${item.score ? `<div class="absolute right-3 top-3 rounded-full bg-black/35 px-2.5 py-1 text-[0.75rem] font-semibold text-white/88 backdrop-blur-md">★ ${escapeHtml(item.score)}</div>` : ""}
							<div class="absolute inset-x-0 bottom-0 p-3 md:p-4">
								<div class="line-clamp-2 text-sm font-bold leading-tight text-white md:text-[0.95rem]">${escapeHtml(item.title)}</div>
								${item.year ? `<div class="mt-1 text-[0.68rem] uppercase tracking-[0.14em] text-white/62 md:text-[0.7rem]">${escapeHtml(item.year)}</div>` : ""}
							</div>
						</div>
						<div class="space-y-3 px-3 py-3 md:px-4">
							<div class="line-clamp-1 text-[0.72rem] text-50 md:text-xs">${escapeHtml(item.originalTitle)}</div>
							${activeTab === "anime" ? `
								<div class="rounded-[0.9rem] bg-[var(--btn-regular-bg)] px-2.5 py-2">
									<div class="mb-1 flex items-center justify-between text-[0.7rem] text-50 md:text-xs">
										<span>Progress</span>
										<span>${escapeHtml(item.watchedEpisodes)}/${escapeHtml(item.totalEpisodes || "?")}</span>
									</div>
									<div class="h-1.5 rounded-full bg-[rgba(255,255,255,0.05)]">
										<div class="h-full rounded-full bg-[var(--primary)]" style="width: ${escapeHtml(item.progressPercent)}%"></div>
									</div>
								</div>
							` : ""}
						</div>
					</a>
				`).join("")}
			</div>
		`;
		}

		const totalPages = Math.ceil(items.length / pageSize);
		paginationRoot.innerHTML = totalPages <= 1
			? ""
			: Array.from({ length: totalPages }, (_, index) => index + 1)
				.filter((page) => {
					if (totalPages <= 7) return true;
					if (page === 1 || page === totalPages) return true;
					return Math.abs(page - currentPage) <= 1;
				})
				.map((page, index, list) => {
					const prev = list[index - 1];
					const ellipsis = prev && page - prev > 1 ? `<span class="px-1 text-50">...</span>` : "";
					return `${ellipsis}<button type="button" class="bangumi-page ${page === currentPage ? "bangumi-page-active" : ""}" data-page="${page}">${page}</button>`;
				})
				.join("");

		paginationRoot.querySelectorAll("[data-page]").forEach((button) => {
			button.addEventListener("click", () => {
				currentPage = Number.parseInt(button.getAttribute("data-page") || "1", 10);
				renderCards();
			});
		});
	};

	const syncTabs = () => {
		tabs.forEach((tab) => {
			const selected = tab.getAttribute("data-target") === activeTab;
			tab.classList.toggle("bangumi-tab-active", selected);
			tab.setAttribute("aria-selected", selected ? "true" : "false");
		});
	};

	tabs.forEach((tab) => {
		tab.addEventListener("click", () => {
			activeTab = tab.getAttribute("data-target") || activeTab;
			activeFilter = "all";
			currentPage = 1;
			syncTabs();
			renderFilters();
			renderCards();
		});
	});

	if (!boardTabs.some((subject) => subject.key === activeTab)) {
		activeTab = boardTabs[0]?.key || "anime";
	}

	syncTabs();
	renderFilters();
	renderCards();
}

initBangumiBoard();
document.addEventListener("astro:page-load", initBangumiBoard);
</script>

<style is:global>
.bangumi-tab {
	@apply relative -mb-[1px] flex items-center gap-1.5 border-b-2 border-transparent pb-2.5 text-sm font-semibold text-[var(--text-secondary)] transition hover:text-[var(--text-normal)];
}

.bangumi-tab-active {
	@apply border-[var(--primary)] text-[var(--primary)];
}

.bangumi-tab-count {
	@apply rounded-full bg-[var(--btn-regular-bg)] px-1.5 py-0.5 text-[0.7rem] leading-none opacity-80;
}

.bangumi-filter {
	@apply rounded-full bg-[var(--btn-regular-bg)] px-3 py-1.5 text-xs font-semibold text-[var(--text-secondary)] transition hover:bg-[var(--btn-regular-bg-hover)] hover:text-[var(--primary)];
}

.bangumi-filter-active {
	@apply bg-[var(--surface-tint)] text-[var(--primary)];
}

.bangumi-stat {
	@apply rounded-[1.05rem] bg-[linear-gradient(180deg,rgba(255,255,255,0.045)_0%,rgba(255,255,255,0.02)_100%)] px-3 py-3 md:px-4;
}

.bangumi-page {
	@apply min-w-9 rounded-[0.85rem] bg-[var(--btn-regular-bg)] px-3 py-2 text-sm font-semibold text-[var(--text-secondary)] transition hover:bg-[var(--btn-regular-bg-hover)] hover:text-[var(--primary)];
}

.bangumi-page-active {
	@apply bg-[var(--surface-tint)] text-[var(--primary)];
}

.bangumi-card {
	@apply transition duration-300 hover:-translate-y-1 hover:shadow-[var(--shadow-card)];
}

.line-clamp-1 {
	display: -webkit-box;
	-webkit-box-orient: vertical;
	-webkit-line-clamp: 1;
	overflow: hidden;
}

.line-clamp-2 {
	display: -webkit-box;
	-webkit-box-orient: vertical;
	-webkit-line-clamp: 2;
	overflow: hidden;
}
</style>
