---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getCategoryUrl, getDir } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	index?: number;
	title: string;
	url: string;
	published: Date;
	category: string | null;
	image: string;
	draft: boolean;
	style: string;
}
const {
	entry,
	index = 0,
	title,
	url,
	published,
	category,
	image,
	style,
} = Astro.props;
const className = Astro.props.class;

const hasCover = image !== undefined && image !== null && image !== "";
const imageOnLeft = index % 2 === 0;
const coverLabel = category || "ARTICLE";
const publishDateLabel = published.toLocaleDateString("en-US", {
	month: "short",
	day: "2-digit",
});

const { remarkPluginFrontmatter } = await entry.render();
---
<div
	class:list={[
		"post-card group card-base relative grid w-full overflow-hidden border-0 !bg-[oklch(from_var(--card-bg-solid)_l_c_h_/_0.7)] backdrop-blur-lg hover:-translate-y-1 hover:shadow-[var(--shadow-card-hover)]",
		{
			"md:min-h-[13rem] md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]": hasCover && imageOnLeft,
			"md:min-h-[13rem] md:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]": hasCover && !imageOnLeft,
		},
		className,
	]}
	style={style}
>
	<div
		class:list={[
			"relative flex flex-col justify-between px-5 py-4 md:px-7 md:py-5",
			{
				"md:order-2 md:-ml-8 md:pl-11 md:pb-18": hasCover && imageOnLeft,
				"md:order-1 md:-mr-8 md:pr-11 md:pb-18": hasCover && !imageOnLeft,
			},
		]}
	>
		<div class="relative z-10">
			<div class="mb-3 flex items-center justify-between gap-3 md:pl-4">
				<div class="rounded-full bg-[var(--btn-regular-bg)] px-2.5 py-1 text-[0.62rem] font-semibold uppercase tracking-[0.18em] text-[var(--btn-content)]">
					{coverLabel}
				</div>
				<div class="text-[0.72rem] font-medium uppercase tracking-[0.16em] text-50">
					{publishDateLabel}
				</div>
			</div>

			<a
				href={url}
				class="relative mb-3 block w-full font-bold leading-tight text-[1.45rem] text-90 transition hover:text-[var(--primary)] active:text-[var(--title-active)] md:text-[1.72rem]"
			>
				<span class="absolute left-0 top-2 hidden h-4.5 w-1 rounded-md bg-[var(--primary)] md:block"></span>
				<span class="block md:pl-4">{title}</span>
			</a>

			<div class="flex flex-wrap items-center gap-3 text-[0.78rem] text-50 md:pl-4">
				<div class="flex items-center gap-2">
					<div class="flex h-7 w-7 items-center justify-center rounded-md bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">
						<Icon name="material-symbols:calendar-today-outline-rounded" class="text-[1rem]" />
					</div>
					<span class="font-medium">{formatDateToYYYYMMDD(published)}</span>
				</div>
				<div class="text-[var(--meta-divider)]">/</div>
				<a
					href={getCategoryUrl(category)}
					aria-label={`View all posts in the ${category || "uncategorized"} category`}
					class="flex items-center gap-2 font-medium hover:text-[var(--primary)]"
				>
					<div class="flex h-7 w-7 items-center justify-center rounded-md bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">
						<Icon name="material-symbols:book-2-outline-rounded" class="text-[1rem]" />
					</div>
					<span>{category || "Uncategorized"}</span>
				</a>
			</div>
		</div>

		<div class="relative z-10 mt-3 flex items-center justify-between gap-4 md:pl-4">
			<div class="text-[0.78rem] text-50 flex gap-3 transition">
				<div>
					{remarkPluginFrontmatter.words} {" " + i18n(remarkPluginFrontmatter.words === 1 ? I18nKey.wordCount : I18nKey.wordsCount)}
				</div>
				<div>|</div>
				<div>
					{remarkPluginFrontmatter.minutes} {" " + i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
				</div>
			</div>
		</div>

	</div>

	{hasCover && (
		<a
			href={url}
			aria-label={title}
			class:list={[
				"group relative min-h-[9.5rem] overflow-hidden md:min-h-[13rem]",
				{
					"md:order-1 rounded-b-none md:rounded-r-none md:[clip-path:polygon(0_0,84%_0,100%_100%,0_100%)]": imageOnLeft,
					"md:order-2 rounded-b-none md:rounded-l-none md:[clip-path:polygon(0_0,100%_0,100%_100%,16%_100%)]": !imageOnLeft,
				},
			]}
		>
			<div class="absolute inset-0 z-10 bg-[linear-gradient(180deg,rgba(10,18,32,0.04)_0%,rgba(10,18,32,0.18)_46%,rgba(10,18,32,0.62)_100%)] transition duration-500 group-hover:bg-[linear-gradient(180deg,rgba(10,18,32,0.02)_0%,rgba(10,18,32,0.12)_38%,rgba(10,18,32,0.72)_100%)]"></div>
			<div class="absolute inset-0 z-20 bg-[radial-gradient(circle_at_top_right,rgba(255,255,255,0.22)_0%,transparent_32%)] opacity-70 transition duration-500 group-hover:scale-110 group-hover:opacity-100"></div>
			<ImageWrapper
				src={image}
				basePath={path.join("content/posts/", getDir(entry.id))}
				alt="Cover Image of the Post"
				class="h-full w-full opacity-[0.85] transition duration-700 ease-out group-hover:scale-[1.08] group-hover:rotate-[1.8deg]"
				widths={[320, 480, 640, 768, 960]}
				sizes="(min-width: 1024px) 34vw, 100vw"
			/>
		</a>
	)}

	<a
		href={url}
		aria-label={title}
		class:list={[
			"absolute bottom-4 right-4 z-40 flex h-10 w-10 items-center justify-center rounded-[0.9rem] transition duration-200 md:bottom-5 md:right-5",
			{
				"bg-[var(--btn-regular-bg)] text-[var(--btn-content)] shadow-[var(--shadow-card)] hover:bg-[var(--btn-regular-bg-hover)] active:bg-[var(--btn-regular-bg-active)]": !hasCover || imageOnLeft,
				"bg-white/6 text-white shadow-[0_12px_30px_-18px_rgba(15,23,42,0.58)] backdrop-blur-md hover:bg-white/12 active:bg-white/10": hasCover && !imageOnLeft,
			},
		]}
	>
		<span
			class:list={[
				"pointer-events-none absolute inset-[1px] rounded-[0.82rem] transition duration-200",
				{
					"hidden": !hasCover || imageOnLeft,
					"bg-[linear-gradient(180deg,rgba(255,255,255,0.14)_0%,rgba(255,255,255,0.04)_42%,rgba(15,23,42,0.08)_100%)]": hasCover && !imageOnLeft,
				},
			]}
		></span>
		<Icon name="fa6-solid:arrow-right" class="relative z-10 text-[1rem]" />
	</a>
</div>
