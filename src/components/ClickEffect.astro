---
import { siteConfig } from "@/config";

const clickEffectConfig = siteConfig.clickEffect;
---

{clickEffectConfig.enable && (
	<>
		<canvas
			id="click-effect-canvas"
			class="pointer-events-none fixed inset-0 z-[999] h-full w-full"
			aria-hidden="true"
		></canvas>
		<script is:inline define:vars={{ clickEffectConfig }}>
			function isTouchDevice() {
				return "ontouchstart" in window || navigator.maxTouchPoints > 0;
			}

			function getThemeHue() {
				const hueValue = getComputedStyle(document.documentElement)
					.getPropertyValue("--hue")
					.trim();
				const parsedHue = Number.parseFloat(hueValue);
				return Number.isFinite(parsedHue) ? parsedHue : 200;
			}

			function getPalette() {
				const hue = getThemeHue();
				return [
					`hsla(${hue}, 90%, 62%, 0.95)`,
					`hsla(${(hue + 12) % 360}, 88%, 70%, 0.9)`,
					`hsla(${(hue + 24) % 360}, 85%, 76%, 0.82)`,
					`hsla(${(hue + 336) % 360}, 92%, 68%, 0.88)`,
				];
			}

			function shouldIgnoreClick(target) {
				if (!(target instanceof Element)) {
					return false;
				}
				return clickEffectConfig.excludeSelectors.some((selector) =>
					target.closest(selector),
				);
			}

			function resizeCanvas(state) {
				if (!state.canvas || !state.ctx) {
					return;
				}
				const dpr = window.devicePixelRatio || 1;
				state.canvas.width = window.innerWidth * dpr;
				state.canvas.height = window.innerHeight * dpr;
				state.canvas.style.width = `${window.innerWidth}px`;
				state.canvas.style.height = `${window.innerHeight}px`;
				state.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			}

			function spawnEffect(state, x, y) {
				const palette = getPalette();
				for (let i = 0; i < 22; i++) {
					const angle = (Math.PI * 2 * i) / 22 + Math.random() * 0.28;
					const speed = 1.2 + Math.random() * 3.1;
					state.particles.push({
						x,
						y,
						vx: Math.cos(angle) * speed,
						vy: Math.sin(angle) * speed,
						size: 1.8 + Math.random() * 3.8,
						alpha: 1,
						decay: 0.014 + Math.random() * 0.018,
						color: palette[i % palette.length],
						blur: 8 + Math.random() * 18,
					});
				}

				for (let i = 0; i < 8; i++) {
					const angle = Math.random() * Math.PI * 2;
					const speed = 0.5 + Math.random() * 1.4;
					state.particles.push({
						x,
						y,
						vx: Math.cos(angle) * speed,
						vy: Math.sin(angle) * speed,
						size: 8 + Math.random() * 10,
						alpha: 0.28 + Math.random() * 0.18,
						decay: 0.01 + Math.random() * 0.008,
						color: palette[(i + 1) % palette.length],
						blur: 24 + Math.random() * 24,
					});
				}

				state.rings.push({
					x,
					y,
					radius: 6,
					maxRadius: 48,
					alpha: 0.62,
					lineWidth: 3.2,
					color: palette[0],
					growth: 2.4,
					decay: 0.024,
				});

				state.rings.push({
					x,
					y,
					radius: 2,
					maxRadius: 24,
					alpha: 0.22,
					lineWidth: 8,
					color: palette[3],
					growth: 1.9,
					decay: 0.03,
				});

				// Add a softer ripple pair so the click feels more like a spreading water wave.
				state.rings.push({
					x,
					y,
					radius: 0,
					maxRadius: 78,
					alpha: 0.28,
					lineWidth: 2.5,
					color: palette[1],
					growth: 2.8,
					decay: 0.012,
				});
				state.rings.push({
					x,
					y,
					radius: 10,
					maxRadius: 112,
					alpha: 0.2,
					lineWidth: 1.5,
					color: palette[2],
					growth: 2.35,
					decay: 0.009,
				});
			}

			function drawFrame(state) {
				if (!state.ctx || !state.canvas) {
					return;
				}

				state.ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);

				state.particles = state.particles.filter((particle) => {
					particle.x += particle.vx;
					particle.y += particle.vy;
					particle.vx *= 0.985;
					particle.vy = particle.vy * 0.985 + 0.015;
					particle.alpha -= particle.decay;

					if (particle.alpha <= 0.02) {
						return false;
					}

					state.ctx.beginPath();
					state.ctx.shadowBlur = particle.blur ?? 0;
					state.ctx.shadowColor = particle.color.replace(/[\d.]+\)$/u, `${Math.min(particle.alpha, 0.4)})`);
					state.ctx.fillStyle = particle.color.replace(/[\d.]+\)$/u, `${particle.alpha})`);
					state.ctx.arc(particle.x, particle.y, particle.size, 0, Math.PI * 2);
					state.ctx.fill();
					state.ctx.shadowBlur = 0;
					return true;
				});

				state.rings = state.rings.filter((ring) => {
					const growth = ring.growth ?? 2.2;
					const decay = ring.decay ?? 0.028;
					ring.radius += growth;
					ring.alpha -= decay;

					if (ring.radius >= ring.maxRadius || ring.alpha <= 0.02) {
						return false;
					}

					state.ctx.beginPath();
					state.ctx.shadowBlur = 14;
					state.ctx.shadowColor = ring.color.replace(/[\d.]+\)$/u, `${Math.min(ring.alpha, 0.22)})`);
					state.ctx.strokeStyle = ring.color.replace(/[\d.]+\)$/u, `${ring.alpha})`);
					state.ctx.lineWidth = ring.lineWidth;
					state.ctx.arc(ring.x, ring.y, ring.radius, 0, Math.PI * 2);
					state.ctx.stroke();
					state.ctx.shadowBlur = 0;
					return true;
				});

				if (state.particles.length > 0 || state.rings.length > 0) {
					state.rafId = window.requestAnimationFrame(() => drawFrame(state));
				} else {
					state.rafId = null;
				}
			}

			function initClickEffect() {
				if (clickEffectConfig.disableOnMobile && isTouchDevice()) {
					return;
				}

				const existingState = window.__CLICK_EFFECT__;
				if (existingState?.clickHandler) {
					return;
				}

				const canvas = document.getElementById("click-effect-canvas");
				if (!(canvas instanceof HTMLCanvasElement)) {
					return;
				}

				const ctx = canvas.getContext("2d");
				if (!ctx) {
					return;
				}

				const state = existingState ?? {
					canvas,
					ctx,
					particles: [],
					rings: [],
					rafId: null,
				};
				state.canvas = canvas;
				state.ctx = ctx;
				window.__CLICK_EFFECT__ = state;

				state.resizeHandler = () => resizeCanvas(state);
				state.clickHandler = (event) => {
					if (shouldIgnoreClick(event.target)) {
						return;
					}

					spawnEffect(state, event.clientX, event.clientY);
					if (state.rafId === null) {
						state.rafId = window.requestAnimationFrame(() => drawFrame(state));
					}
				};

				resizeCanvas(state);
				window.addEventListener("resize", state.resizeHandler);
				window.addEventListener("click", state.clickHandler, { passive: true });
			}

			initClickEffect();
			document.addEventListener("astro:page-load", initClickEffect);
		</script>
	</>
)}
