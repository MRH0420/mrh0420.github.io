---

import { profileConfig } from "../config";
import { url } from "../utils/url-utils";

const currentYear = new Date().getFullYear();
---

<!--<div class="border-t border-[var(&#45;&#45;primary)] mx-16 border-dashed py-8 max-w-[var(&#45;&#45;page-width)] flex flex-col items-center justify-center px-6">-->
<div class="transition border-t border-[var(--card-border)] my-10 border-dashed mx-4 md:mx-10 lg:mx-16"></div>
<!--<div class="transition bg-[oklch(92%_0.01_var(&#45;&#45;hue))] dark:bg-black rounded-2xl py-8 mt-4 mb-8 flex flex-col items-center justify-center px-6">-->
<div class="transition rounded-[var(--radius-card)] border border-dashed border-[var(--card-border)] bg-[oklch(from_var(--card-bg-solid)_l_c_h_/_0.55)] mb-12 flex flex-col items-center justify-center px-5 py-6 md:px-6">
    <div class="transition text-50 text-sm text-center">
        &copy; <span id="copyright-year">{currentYear}</span> {profileConfig.name}. All Rights Reserved. /
        <a class="transition link text-[var(--primary)] font-medium" href={url('rss.xml')}>RSS</a> /
        <a class="transition link text-[var(--primary)] font-medium" href={url('sitemap-index.xml')}>Sitemap</a><br>
        Powered by
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" rel="noreferrer" href="https://astro.build">Astro</a> &
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" rel="noreferrer" href="https://github.com/saicaca/fuwari">Fuwari</a>
    </div>
</div>
