---
interface Props {
	class?: string;
	flip?: boolean;
	opacity?: number;
	reactive?: boolean;
}

const {
	class: className = "",
	flip = false,
	opacity = 0.92,
	reactive = false,
} = Astro.props;
---

<div
	class:list={[
		"pointer-events-none absolute left-0 w-full overflow-visible leading-none",
		flip ? "top-0 rotate-180" : "bottom-0",
		className,
	]}
	data-reactive={reactive ? "true" : "false"}
	aria-hidden="true"
>
	<!-- Layered fog softens the seam instead of drawing a visible divider line. -->
	<div
		class:list={[
			"absolute inset-x-[-8%] h-[4.5rem] blur-[16px]",
			flip
				? "-top-[1.25rem] bg-[linear-gradient(180deg,oklch(from_var(--page-bg)_l_c_h_/_0.3)_0%,oklch(from_var(--page-bg)_l_c_h_/_0.14)_46%,transparent_100%)]"
				: "-top-[1.25rem] bg-[linear-gradient(180deg,oklch(from_var(--page-bg)_l_c_h_/_0.12)_0%,oklch(from_var(--page-bg)_l_c_h_/_0.04)_48%,transparent_100%)]",
		]}
	></div>
	<div
		class="absolute inset-x-[-6%] inset-y-[-12%] bg-[linear-gradient(180deg,transparent_0%,oklch(from_var(--page-bg)_l_c_h_/_0.08)_18%,oklch(from_var(--page-bg)_l_c_h_/_0.16)_42%,oklch(from_var(--page-bg)_l_c_h_/_0.28)_68%,oklch(from_var(--page-bg)_l_c_h_/_0.42)_100%)] blur-[12px]"
	></div>
	<svg
		class="waves relative h-full w-full min-h-[3.5rem] opacity-75 blur-[1px] md:min-h-[4.75rem]"
		xmlns="http://www.w3.org/2000/svg"
		xmlns:xlink="http://www.w3.org/1999/xlink"
		viewBox="0 20 150 32"
		preserveAspectRatio="none"
		shape-rendering="auto"
	>
		<defs>
			<path
				id="gentle-wave"
				d="M-160 44c30 0 58-18 88-18s58 18 88 18 58-18 88-18 58 18 88 18v48h-352z"
			></path>
		</defs>
		<g class="parallax">
			<use
				xlink:href="#gentle-wave"
				x="48"
				y="0"
				fill={`oklch(from var(--page-bg) l c h / ${Math.min(opacity * 0.16, 0.22)})`}
				style="animation-delay: -2s; animation-duration: 9s;"
			></use>
			<use
				xlink:href="#gentle-wave"
				x="48"
				y="3"
				fill={`oklch(from var(--page-bg) l c h / ${Math.min(opacity * 0.3, 0.4)})`}
				style="animation-delay: -3s; animation-duration: 12s;"
			></use>
			<use
				xlink:href="#gentle-wave"
				x="48"
				y="5"
				fill={`oklch(from var(--page-bg) l c h / ${Math.min(opacity * 0.46, 0.56)})`}
				style="animation-delay: -4s; animation-duration: 16s;"
			></use>
			<use
				xlink:href="#gentle-wave"
				x="48"
				y="7"
				fill={`oklch(from var(--page-bg) l c h / ${Math.min(opacity * 0.62, 0.75)})`}
				style="animation-delay: -5s; animation-duration: 22s;"
			></use>
		</g>
	</svg>
	<div
		class="absolute inset-x-[-10%] bottom-[-0.5rem] h-[58%] bg-[linear-gradient(180deg,transparent_0%,oklch(from_var(--page-bg)_l_c_h_/_0.12)_30%,oklch(from_var(--page-bg)_l_c_h_/_0.22)_54%,oklch(from_var(--page-bg)_l_c_h_/_0.32)_78%,oklch(from_var(--page-bg)_l_c_h_/_0.44)_100%)] blur-[14px]"
	></div>
	<div
		class:list={[
			"absolute inset-x-[-10%] h-[3.75rem] blur-[16px]",
			flip
				? "-top-[2rem] bg-[linear-gradient(180deg,oklch(from_var(--page-bg)_l_c_h_/_0.24)_0%,oklch(from_var(--page-bg)_l_c_h_/_0.1)_46%,transparent_100%)]"
				: "-bottom-[2rem] bg-[linear-gradient(180deg,transparent_0%,oklch(from_var(--page-bg)_l_c_h_/_0.12)_44%,oklch(from_var(--page-bg)_l_c_h_/_0.24)_100%)]",
		]}
	></div>
	<div
		class:list={[
			"absolute inset-x-[-4%] h-[4.25rem] blur-[20px]",
			flip
				? "-top-[2.5rem] bg-[linear-gradient(180deg,oklch(from_var(--page-bg)_l_c_h_/_0.3)_0%,oklch(from_var(--page-bg)_l_c_h_/_0.12)_52%,transparent_100%)]"
				: "-bottom-[2.75rem] bg-[linear-gradient(180deg,transparent_0%,oklch(from_var(--page-bg)_l_c_h_/_0.16)_34%,oklch(from_var(--page-bg)_l_c_h_/_0.3)_100%)]",
		]}
	></div>
	<div
		class:list={[
			"absolute inset-x-[2%] h-[3.5rem] blur-[18px]",
			flip
				? "-top-[1.5rem] bg-[radial-gradient(ellipse_at_center,oklch(from_var(--page-bg)_l_c_h_/_0.18)_0%,oklch(from_var(--page-bg)_l_c_h_/_0.08)_42%,transparent_78%)]"
				: "-bottom-[1.5rem] bg-[radial-gradient(ellipse_at_center,oklch(from_var(--page-bg)_l_c_h_/_0.2)_0%,oklch(from_var(--page-bg)_l_c_h_/_0.08)_40%,transparent_78%)]",
		]}
	></div>
	<div
		class:list={[
			"absolute inset-x-[-12%] h-[5rem] blur-[24px]",
			flip
				? "-top-[3rem] bg-[linear-gradient(180deg,oklch(from_var(--page-bg)_l_c_h_/_0.18)_0%,transparent_100%)]"
				: "-bottom-[3.5rem] bg-[linear-gradient(180deg,transparent_0%,oklch(from_var(--page-bg)_l_c_h_/_0.2)_100%)]",
		]}
	></div>
</div>
